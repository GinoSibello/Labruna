server {
    listen 443 ssl http2;
    server_name documentos.ejemplo.com;

    # Configurar certificados TLS administrados por la infraestructura.
    ssl_certificate /etc/letsencrypt/live/documentos.ejemplo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/documentos.ejemplo.com/privkey.pem;

    client_max_body_size 15m;
    proxy_read_timeout 130s;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
