# URL publica exacta de la aplicacion, sin barra final.
APP_ORIGIN=https://documentos.ejemplo.com
NEXT_PUBLIC_BASE_PATH=/labruna
APP_PORT=3100

# Minimo 32 caracteres aleatorios. Ejemplo: openssl rand -base64 48
SESSION_SECRET=change-this-with-at-least-32-random-characters
SESSION_TTL_HOURS=8
USERS_FILE=/run/secrets/users.json

# Directorio persistente y limites del MVP.
TEMP_UPLOAD_DIR=/app/data/uploads
TEMP_UPLOAD_TTL_MINUTES=30
MAX_UPLOAD_MB=15
N8N_TIMEOUT_MS=120000

# Activacion gradual por modulo.
FEATURE_REMITOS=true
FEATURE_CHAPAS=false
FEATURE_CHEQUES=false

# Solo para desarrollo o demostracion local. Mantener false en produccion.
DEV_AUTH_BYPASS=false
N8N_MOCK_MODE=false

# Secreto compartido por los webhooks privados nuevos de n8n.
N8N_WEBHOOK_SECRET=change-this-shared-secret

N8N_REMITOS_ANALYZE_URL=http://n8n:5678/webhook/web/remitos/analyze/v1
N8N_REMITOS_CONFIRM_URL=http://n8n:5678/webhook/web/remitos/confirm/v1
N8N_CHAPAS_ANALYZE_URL=http://n8n:5678/webhook/web/chapas/analyze/v1
N8N_CHAPAS_CONFIRM_URL=http://n8n:5678/webhook/web/chapas/confirm/v1
N8N_CHEQUES_ANALYZE_URL=http://n8n:5678/webhook/web/cheques/analyze/v1
N8N_CHEQUES_CONFIRM_URL=http://n8n:5678/webhook/web/cheques/confirm/v1
N8N_SHEET_OPTIONS_URL=http://n8n:5678/webhook/web/sheet-options/v1
